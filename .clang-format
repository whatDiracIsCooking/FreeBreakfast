# Enforced: devtools/format.sh --check runs at commit (staged files) and in
# CI's `lint` job, and fails on any drift. Fix with devtools/format.sh, which
# rewrites in place. The binary is the clang-format wheel pinned in uv.lock, so
# host and image agree byte for byte. docs/style.md has the rest of the style --
# the parts no formatter can check.
#
# `// clang-format off` / `// clang-format on` is the one escape, for a table
# whose column alignment carries meaning (vec.h's specializations). Nothing
# else.
---
Language: Cpp
BasedOnStyle: LLVM

ColumnLimit: 100
IndentWidth: 2
TabWidth: 2
UseTab: Never

# `.cu` and `.cuh` are not in clang-format's default extension list; they are
# handled because the CUDA sources here are ordinary C++ to the formatter.
Standard: c++20

AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Attach
PointerAlignment: Right
ReferenceAlignment: Right

# Doxygen banners in these files are hand-wrapped; leave them alone.
ReflowComments: false

# Keep `module;`, `export module X;`, and the import block stable rather than
# letting the sorter reorder module declarations.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve
