@@ before <h2 id="the-shape">
<style>
/* The design figures, from docs/rust-redesign.html. Their palette is scoped
   to the figures, so it does not touch the page's own variables. */
figure.fig, .legend, .tools, .frame, #detail {
  --panel: #ffffff; --ink: #1c1d21; --muted: #666a73;
  --line: #d9d7cf; --hot: #c2410c;
  --setup-bg: #e2f1ee; --setup-bd: #2b8a7a;
  --int-bg: #e6e8fb; --int-bd: #4b55c4;
  --la-bg: #fbeeda; --la-bd: #b7791f;
  --edge: #9a9da6; --input-bg: #efeee9; --input-bd: #a3a6ad;
  --scf-bg: #f1e9f5; --scf-bd: #8a4fa3;
  --c1: #2a78d6; --c2: #eb6834; --c3: #1baf7a; --c4: #eda100;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) :is(figure.fig, .legend, .tools, .frame, #detail) {
    --panel: #1f2126; --ink: #e8e8ea; --muted: #9a9ea8;
    --line: #33363d; --hot: #fb923c;
    --setup-bg: #17332f; --setup-bd: #4fb8a6;
    --int-bg: #23274f; --int-bd: #8891f0;
    --la-bg: #3a2c14; --la-bd: #e0a84a;
    --edge: #6d717b; --input-bg: #26282e; --input-bd: #747985;
    --scf-bg: #33233b; --scf-bd: #c08ad6;
    --c1: #3987e5; --c2: #d95926; --c3: #199e70; --c4: #c98500;
  }
}
figure.fig { margin: 1.2rem 0 1.6rem; background: var(--panel);
             border: 1px solid var(--line); border-radius: 8px;
             padding: 10px 12px 8px; overflow-x: auto; color: var(--ink); }
.fig svg { display: block; width: 100%; min-width: 700px; height: auto; }
.fig text { fill: var(--ink); font: 12.5px system-ui, -apple-system, "Segoe UI", sans-serif; }
.fig text.m { fill: var(--muted); }
.fig text.b { font-weight: 600; }
.fig text.s { font-size: 11.5px; }
.fig text.mono { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
                 font-size: 11.5px; }
.fig rect, .fig path, .fig line { stroke-width: 1.5; }
.fig .f-bus { fill: none; stroke: var(--edge); }
.fig .f-plain { fill: var(--input-bg); stroke: var(--input-bd); }
.fig .f-setup { fill: var(--setup-bg); stroke: var(--setup-bd); }
.fig .f-int { fill: var(--int-bg); stroke: var(--int-bd); }
.fig .f-la { fill: var(--la-bg); stroke: var(--la-bd); }
.fig .f-scf { fill: var(--scf-bg); stroke: var(--scf-bd); }
.fig .f-wait { fill: var(--panel); stroke: var(--input-bd); stroke-dasharray: 4 3; }
.fig .f-hot { fill: none; stroke: var(--hot); }
.fig .f-read { fill: none; stroke: var(--edge); stroke-dasharray: 5 3; }
.fig .f-rule { stroke: var(--line); }
.fig .f-cap { stroke: var(--hot); stroke-dasharray: 6 4; }
.fig marker path.hot { fill: var(--hot); stroke: none; }
.fig marker path.grey { fill: var(--edge); stroke: none; }
.fig figcaption { color: var(--muted); margin-top: 6px; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 12px 0 10px;
          font: 13px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
          color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.sw { width: 14px; height: 14px; border-radius: 3px; border: 1.5px solid; }
.sw.input { background: var(--input-bg); border-color: var(--input-bd); border-style: dashed; }
.sw.setup { background: var(--setup-bg); border-color: var(--setup-bd); }
.sw.int { background: var(--int-bg); border-color: var(--int-bd); }
.sw.la { background: var(--la-bg); border-color: var(--la-bd); }
.sw.scf { background: var(--scf-bg); border-color: var(--scf-bd); border-style: dashed; }
.frame { background: var(--panel); border: 1px solid var(--line);
         border-radius: 10px; overflow: hidden; height: min(80vh, 860px);
         touch-action: none; cursor: grab; }
.frame.drag { cursor: grabbing; }
.tools { display: flex; gap: 6px; align-items: center; margin: 0 0 8px;
         font: 13px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
         color: var(--muted); flex-wrap: wrap; }
.tools button { font: inherit; color: var(--ink); background: var(--panel);
                border: 1px solid var(--line); border-radius: 6px; padding: 4px 10px;
                cursor: pointer; min-width: 34px; }
.tools button:hover { border-color: var(--edge); }
.frame svg { display: block; width: 100%; height: 100%; }
.node rect { stroke-width: 1.5; rx: 7; }
.node { cursor: pointer; }
.node text { fill: var(--ink); pointer-events: none; }
.node .t { font-size: 13.5px; font-weight: 600; }
.node .s { font-size: 12px; fill: var(--muted); }
.k-input rect { fill: var(--input-bg); stroke: var(--input-bd); stroke-dasharray: 5 3; }
.k-setup rect { fill: var(--setup-bg); stroke: var(--setup-bd); }
.k-int rect { fill: var(--int-bg); stroke: var(--int-bd); }
.k-la rect { fill: var(--la-bg); stroke: var(--la-bd); }
.k-scf rect { fill: var(--scf-bg); stroke: var(--scf-bd); stroke-dasharray: 7 4; }
.edge { fill: none; stroke: var(--edge); stroke-width: 1.3; }
.edge.on { stroke: var(--hot); stroke-width: 2.2; }
.dim { opacity: 0.18; }
.node.sel rect { stroke: var(--hot); stroke-width: 2.6; }
#mk path { fill: var(--edge); } #mkon path { fill: var(--hot); }
#detail { margin: 12px 0 14px; padding: 12px 14px; background: var(--panel);
          color: var(--ink); border: 1px solid var(--line); border-radius: 10px;
          min-height: 92px;
          font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
#detail h3 { margin: 0 0 4px; font-size: 15px; }
#detail p { margin: 0; }
#detail dl { margin: 0; display: grid; grid-template-columns: 110px 1fr; gap: 2px 10px;
             font-size: 14px; }
#detail dt { color: var(--muted); }
#detail dd { margin: 0; }
#budgetbars .bar { transition: opacity .12s; }
#budgetbars g.brow:hover .bar { opacity: .75; }
#budgetbars .grid { stroke: var(--line); stroke-width: 1; }
.node .mb { fill: var(--c1); }
</style>
@@ replace-pre FIGURE-01
<figure class="fig">
<svg viewBox="0 0 900 330" role="img" aria-label="The MainBus: shared state on top, one Output slot per step, each step writing its own slot and reading earlier ones">
  <defs>
    <marker id="fah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="hot" d="M0,1 L10,5 L0,9 z"/></marker>
    <marker id="fag" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="grey" d="M0,1 L10,5 L0,9 z"/></marker>
  </defs>
  <rect class="f-bus" x="18" y="14" width="864" height="200" rx="12"/>
  <text class="b" x="34" y="38">MainBus</text>
  <text class="m s" x="100" y="38">shared by every task body as Arc&lt;MainBus&gt;</text>
  <rect class="f-plain" x="40" y="56" width="184" height="46" rx="6"/>
  <text class="b" x="132" y="75" text-anchor="middle">config</text>
  <text class="m s" x="132" y="92" text-anchor="middle">options and limits</text>
  <rect class="f-setup" x="252" y="56" width="184" height="46" rx="6"/>
  <text class="b" x="344" y="75" text-anchor="middle">dimensions</text>
  <text class="m s" x="344" y="92" text-anchor="middle">n_atom, n_ao, n_aux, n_occ</text>
  <rect class="f-la" x="464" y="56" width="184" height="46" rx="6"/>
  <text class="b" x="556" y="75" text-anchor="middle">caps and counters</text>
  <text class="m s" x="556" y="92" text-anchor="middle">sum per kind; scratch packed</text>
  <rect class="f-scf" x="676" y="56" width="184" height="46" rx="6"/>
  <text class="mono" x="768" y="75" text-anchor="middle">GpuResources</text>
  <text class="m s" x="768" y="92" text-anchor="middle">one per GPU, one lock</text>
  <text class="m s" x="40" y="136">One Output per step: allocated in budget mode, filled in execute mode, rewritten in place on a replay</text>
  <rect class="f-int" x="40" y="150" width="184" height="46" rx="6"/>
  <text class="mono" x="132" y="169" text-anchor="middle">RwLock&lt;XOutput&gt;</text>
  <text class="m s" x="132" y="186" text-anchor="middle">bus.orthogonalizer</text>
  <rect class="f-la" x="62" y="262" width="140" height="34" rx="6"/>
  <text class="b" x="132" y="284" text-anchor="middle">XStep</text>
  <path class="f-hot" marker-end="url(#fah)" d="M110,262 L110,198"/>
  <path class="f-read" marker-end="url(#fag)" d="M190,196 C190,232 312,226 312,260"/>
  <rect class="f-int" x="252" y="150" width="184" height="46" rx="6"/>
  <text class="mono" x="344" y="169" text-anchor="middle">RwLock&lt;EriManager&gt;</text>
  <text class="m s" x="344" y="186" text-anchor="middle">bus.eri</text>
  <rect class="f-la" x="274" y="262" width="140" height="34" rx="6"/>
  <text class="b" x="344" y="284" text-anchor="middle">EriStep</text>
  <path class="f-hot" marker-end="url(#fah)" d="M322,262 L322,198"/>
  <path class="f-read" marker-end="url(#fag)" d="M402,196 C402,232 524,226 524,260"/>
  <rect class="f-int" x="464" y="150" width="184" height="46" rx="6"/>
  <text class="mono" x="556" y="169" text-anchor="middle">RwLock&lt;ScfOutput&gt;</text>
  <text class="m s" x="556" y="186" text-anchor="middle">bus.scf</text>
  <rect class="f-la" x="486" y="262" width="140" height="34" rx="6"/>
  <text class="b" x="556" y="284" text-anchor="middle">ScfStep</text>
  <path class="f-hot" marker-end="url(#fah)" d="M534,262 L534,198"/>
  <path class="f-read" marker-end="url(#fag)" d="M614,196 C614,232 736,226 736,260"/>
  <rect class="f-int" x="676" y="150" width="184" height="46" rx="6"/>
  <text class="mono" x="768" y="169" text-anchor="middle">RwLock&lt;CasscfOutput&gt;</text>
  <text class="m s" x="768" y="186" text-anchor="middle">bus.casscf</text>
  <rect class="f-la" x="698" y="262" width="140" height="34" rx="6"/>
  <text class="b" x="768" y="284" text-anchor="middle">CasscfStep</text>
  <path class="f-hot" marker-end="url(#fah)" d="M746,262 L746,198"/>
  <path class="f-hot" marker-end="url(#fah)" d="M40,316 L76,316"/>
  <text class="s" x="84" y="320">write(): the owning step only</text>
  <path class="f-read" marker-end="url(#fag)" d="M300,316 L336,316"/>
  <text class="s" x="344" y="320">read(): through the reader's declared View; the builder makes these the DAG's edges</text>
</svg>
<figcaption>The <code>MainBus</code>. Everything above the slots is filled before budget
mode. Each step writes one slot and reads what it needs from the others; on a chain the
locks are never contended.</figcaption>
</figure>
@@ replace-pre FIGURE-02
<figure class="fig">
<svg viewBox="0 0 900 274" role="img" aria-label="One GPU's counters: Output allocations add along a bar toward the cap; scratch declarations are packed by the closure of the DAG, and the final node adds the packed peak at the end">
  <defs>
    <marker id="fbh" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="hot" d="M0,1 L10,5 L0,9 z"/></marker>
    <marker id="fbg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="grey" d="M0,1 L10,5 L0,9 z"/></marker>
  </defs>
  <text class="b" x="20" y="34">gpu0: the sum counter</text>
  <text class="m s" x="20" y="85">each Output adds</text>
  <rect class="f-int" x="150" y="60" width="30" height="40"/>
  <text class="s" x="165" y="52" text-anchor="middle">X</text>
  <rect class="f-int" x="180" y="60" width="300" height="40"/>
  <text x="330" y="85" text-anchor="middle">ERI</text>
  <rect class="f-int" x="480" y="60" width="120" height="40"/>
  <text x="540" y="85" text-anchor="middle">SCF</text>
  <rect class="f-int" x="600" y="60" width="90" height="40"/>
  <text x="645" y="85" text-anchor="middle">CASSCF</text>
  <rect class="f-scf" x="690" y="60" width="60" height="40"/>
  <text class="s" x="720" y="52" text-anchor="middle">scratch</text>
  <line class="f-cap" x1="800" y1="40" x2="800" y2="116"/>
  <text class="s" x="806" y="52">cap</text>
  <text class="m s" x="775" y="128" text-anchor="middle">room left</text>
  <path class="f-read" marker-end="url(#fbg)" d="M150,112 L688,112"/>
  <text class="m s" x="150" y="128">charged and allocated step by step, in any order, during the budget DAG</text>

  <text class="b" x="20" y="152">gpu0: the scratch slab</text>
  <text class="m s" x="20" y="203">each declaration a region</text>
  <rect class="f-scf" x="150" y="166" width="60" height="16"/>
  <text class="s" x="218" y="179">X: eigensolve's work at n_ao</text>
  <rect class="f-scf" x="150" y="190" width="60" height="16"/>
  <text class="s" x="218" y="203">SCF: eigensolve's work at n_ao</text>
  <rect class="f-scf" x="150" y="214" width="38" height="16"/>
  <text class="s" x="218" y="227">ERI: its orbital records</text>
  <path class="f-hot" marker-end="url(#fbh)" d="M400,186 C560,186 720,170 720,104"/>
  <text class="s" x="470" y="214">the final node packs them: ordered steps</text>
  <text class="s" x="470" y="230">share bytes, unordered ones do not</text>
  <text class="m s" x="20" y="262">Over the cap at any point: the flag is set, allocation stops, counting continues, and the final node prints the table and exits.</text>
</svg>
<figcaption>What one GPU's two counters hold. <code>Output</code>s are a sum; step
scratch, which holds every library call's work buffer, is packed, and its peak is known
only when every step has declared, which is why the final node exists. The SCF follows
both X and ERI, so its region may overlap either; X and ERI are unordered, so theirs stay
apart, though both take gpu0's lock and so run one after the other
(<a href="#one-handle-set-per-gpu-under-its-lock">below</a>). The bar's scratch segment also
carries the fixed handle workspace. Bars not to scale.</figcaption>
</figure>
@@ replace-pre FIGURE-03
<figure class="fig">
<svg viewBox="0 0 900 300" role="img" aria-label="One cells entry: six fields, read field-major; the first two give a range of orbital pair records, the next two a range of aux records, the fifth the block of the slab the result is written to">
  <defs>
    <marker id="mf-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="grey" d="M0,1 L10,5 L0,9 z"/></marker>
  </defs>
  <text x="110" y="40" class="b">cells</text>
  <text x="152" y="40" class="m s">field-major: each field one segment, entries along it</text>
  <g>
    <!-- 6 fields x 7 entries; entry k highlighted -->
    <rect class="f-plain" x="110" y="52" width="238" height="132" rx="4"/>
    <rect class="f-la" x="212" y="52" width="34" height="132"/>
    <line class="f-rule" x1="110" y1="74" x2="348" y2="74"/>
    <line class="f-rule" x1="110" y1="96" x2="348" y2="96"/>
    <line class="f-rule" x1="110" y1="118" x2="348" y2="118"/>
    <line class="f-rule" x1="110" y1="140" x2="348" y2="140"/>
    <line class="f-rule" x1="110" y1="162" x2="348" y2="162"/>
    <line class="f-rule" x1="144" y1="52" x2="144" y2="184"/>
    <line class="f-rule" x1="178" y1="52" x2="178" y2="184"/>
    <line class="f-rule" x1="280" y1="52" x2="280" y2="184"/>
    <line class="f-rule" x1="314" y1="52" x2="314" y2="184"/>
    <text x="102" y="67" text-anchor="end" class="mono">orb begin</text>
    <text x="102" y="89" text-anchor="end" class="mono">orb end</text>
    <text x="102" y="111" text-anchor="end" class="mono">aux begin</text>
    <text x="102" y="133" text-anchor="end" class="mono">aux end</text>
    <text x="102" y="155" text-anchor="end" class="mono">out offset</text>
    <text x="102" y="177" text-anchor="end" class="mono">diagonal</text>
    <text x="229" y="200" text-anchor="middle" class="s b">entry k</text>
    <text x="229" y="216" text-anchor="middle" class="m s">one (shell pair, aux shell)</text>
  </g>
  <!-- orbital pair records -->
  <text x="470" y="40" class="b">orbital pair records</text>
  <text x="612" y="40" class="m s">eri's scratch, on the device</text>
  <rect class="f-int" x="470" y="52" width="400" height="22" rx="4"/>
  <rect class="f-hot" x="595" y="52" width="75" height="22"/>
  <text x="632" y="68" text-anchor="middle" class="s">[begin, end)</text>
  <!-- aux records -->
  <text x="470" y="104" class="b">aux_records</text>
  <text x="556" y="104" class="m s">5 fields × n_aux_prim</text>
  <rect class="f-la" x="470" y="114" width="400" height="80" rx="4"/>
  <line class="f-rule" x1="470" y1="130" x2="870" y2="130"/>
  <line class="f-rule" x1="470" y1="146" x2="870" y2="146"/>
  <line class="f-rule" x1="470" y1="162" x2="870" y2="162"/>
  <line class="f-rule" x1="470" y1="178" x2="870" y2="178"/>
  <rect class="f-hot" x="695" y="114" width="50" height="80"/>
  <text x="462" y="126" text-anchor="end" class="mono">x</text>
  <text x="462" y="142" text-anchor="end" class="mono">y</text>
  <text x="462" y="158" text-anchor="end" class="mono">z</text>
  <text x="462" y="174" text-anchor="end" class="mono">α</text>
  <text x="462" y="190" text-anchor="end" class="mono">c·w</text>
  <!-- slab -->
  <text x="470" y="234" class="b">(μν|P)</text>
  <text x="522" y="234" class="m s">into a ring buffer: a pair batch × n_aux</text>
  <rect class="f-int" x="470" y="244" width="400" height="24" rx="4"/>
  <rect class="f-hot" x="640" y="244" width="24" height="24"/>
  <!-- arrows -->
  <path class="f-read" marker-end="url(#mf-a)" d="M246,74 C400,74 450,63 593,63"/>
  <path class="f-read" marker-end="url(#mf-a)" d="M246,118 C420,118 560,154 693,154"/>
  <path class="f-read" marker-end="url(#mf-a)" d="M246,151 C380,151 560,256 638,256"/>
  <text x="110" y="262" class="m s">"diagonal" marks a shell's pair with itself,</text>
  <text x="110" y="278" class="m s">which the symmetry weight counts once.</text>
</svg>
<figcaption>What a work list entry is. One entry of <code>cells</code> is six integers:
two ranges into record arrays (the orbital pairs eri's records hold, and this
step's own aux records), and where in the slab the kernel writes. The other work
lists are the same shape with other fields. Nothing in an entry is a pointer, so every
array is sized by counting, before anything is built.</figcaption>
</figure>
@@ replace-pre FIGURE-04
<figure class="fig">
<svg viewBox="0 0 900 250" role="img" aria-label="Records and work lists across the three phases: setup counts their lengths into Dims; budget mode declares them as scratch and builds nothing; execute mode builds into the pinned region, uploads and launches">
  <defs>
    <marker id="mf-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="grey" d="M0,1 L10,5 L0,9 z"/></marker>
  </defs>
  <rect class="f-setup" x="10" y="20" width="270" height="214" rx="9"/>
  <rect class="f-la" x="310" y="20" width="280" height="214" rx="9"/>
  <rect class="f-int" x="620" y="20" width="270" height="214" rx="9"/>
  <text x="26" y="44" class="b">Setup</text>
  <text x="80" y="44" class="m s">outside the DAG, unbudgeted</text>
  <text x="26" y="70">reads the geometry and both bases,</text>
  <text x="26" y="88">and counts; builds no array</text>
  <text style="white-space:pre" x="26" y="116" class="mono">n_aux_prim    1,272</text>
  <text style="white-space:pre" x="26" y="134" class="mono">n_aux_shell   1,272</text>
  <text style="white-space:pre" x="26" y="152" class="mono">n_shell_pair  58,653</text>
  <text style="white-space:pre" x="26" y="170" class="mono">n_col         270,497</text>
  <text x="26" y="212" class="m">→ Dims, on the bus</text>
  <text x="326" y="44" class="b">Budget mode</text>
  <text x="416" y="44" class="m s">mem_budget, per step</text>
  <text style="white-space:pre" x="326" y="70">1  declare length × field bytes,</text>
  <text style="white-space:pre" x="326" y="88">    pinned and device scratch</text>
  <text style="white-space:pre" x="326" y="112">2  final node packs and allocates</text>
  <text style="white-space:pre" x="326" y="136">3  build nothing</text>
  <rect class="f-wait" x="326" y="156" width="248" height="62" rx="6"/>
  <text x="338" y="176" class="s">refused, or --budget-only:</text>
  <text x="338" y="193" class="s">empty buffers, nothing built,</text>
  <text x="338" y="210" class="s">every length in the table exact</text>
  <text x="636" y="44" class="b">Execute mode</text>
  <text x="742" y="44" class="m s">run, every replay</text>
  <text style="white-space:pre" x="636" y="70">1  build into the pinned region</text>
  <text style="white-space:pre" x="636" y="88" class="m s">     in place: the centres move</text>
  <text style="white-space:pre" x="636" y="112">2  upload on the step's stream</text>
  <text style="white-space:pre" x="636" y="136">3  launch over the work lists</text>
  <text x="636" y="176" class="m s">allocates nothing; the lengths</text>
  <text x="636" y="193" class="m s">never change between replays</text>
  <path class="f-bus" marker-end="url(#mf-b)" d="M280,127 L308,127"/>
  <path class="f-bus" marker-end="url(#mf-b)" d="M590,127 L618,127"/>
</svg>
<figcaption>Where a step's records and work lists have their three facts: their length
in setup, their bytes in budget mode, their contents in execute mode. gly10's counts
shown.</figcaption>
</figure>
