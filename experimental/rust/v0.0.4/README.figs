@@ after spliced in after this paragraph
<script>
(() => {
const NODES = [
  // inputs
  {id:"in_q", ph:'config', mb:'',   layer:0, x:0,    kind:"input", label:"charge, multiplicity", sub:"input",
   out:"Net charge and spin multiplicity", size:"2 integers", note:"Given by the user."},
  {id:"in_xyz", ph:'config', mb:'', layer:0, x:1.0,  kind:"input", label:"geometry file", sub:"input",
   out:"Element symbols and Cartesian coordinates, as text", size:"N_atom lines",
   note:"Given by the user."},
  {id:"in_ob", ph:'config', mb:'',  layer:0, x:5.0,  kind:"input", label:"orbital basis name", sub:"input",
   out:"Which orbital basis library entry to use", size:"a name",
   note:"Given by the user."},
  {id:"in_ab", ph:'config', mb:'',  layer:0, x:9.8,  kind:"input", label:"auxiliary basis name", sub:"input",
   out:"Which fitting basis library entry to use", size:"a name",
   note:"Given by the user, or chosen to match the orbital basis."},

  // reads
  {id:"read_xyz", ph:'setup', mb:'Not budgeted: small host data, under the exclusion. Fills n_atom', layer:1, x:1.0, kind:"setup", label:"read geometry", sub:"Z_A, R_A",
   deps:["in_xyz"], out:"Atomic numbers Z_A and positions R_A, in bohr",
   size:"N_atom × 4", note:"Parses the file and converts units."},
  {id:"read_ob", ph:'setup', mb:'Not budgeted',  layer:1, x:5.0, kind:"setup", label:"read orbital basis",
   sub:"shells per element", deps:["in_ob"],
   out:"Per element: each shell's angular momentum, exponents and contraction coefficients",
   size:"per element", note:"A library lookup. Knows nothing about the molecule yet."},
  {id:"read_ab", ph:'setup', mb:'Not budgeted',  layer:1, x:9.8, kind:"setup", label:"read auxiliary basis",
   sub:"shells per element", deps:["in_ab"],
   out:"Per element: each fitting shell's angular momentum, exponents and coefficients",
   size:"per element",
   note:"Density fitting needs a second basis, so it needs a second read."},

  // derived setup
  {id:"nelec", ph:'setup', mb:'Not budgeted. Fills n_occ', layer:2, x:0, kind:"setup", label:"electron count", sub:"N_occ",
   deps:["in_q","read_xyz"],
   out:"Number of electrons and of occupied orbitals", size:"integers",
   note:"Sum of Z_A minus the charge. Fixes the occupation the SCF fills."},
  {id:"enuc", ph:'setup', mb:'Not budgeted',  layer:2, x:1.0, kind:"setup", label:"nuclear repulsion", sub:"E_nuc",
   deps:["read_xyz"],
   out:"E_nuc = Σ_{A<B} Z_A Z_B / |R_A − R_B|", size:"1 number",
   note:"A constant added to the electronic energy."},
  {id:"obs", ph:'setup', mb:'Not budgeted. Fills n_ao and the shell counts',   layer:2, x:5.0, kind:"setup", label:"create orbital basis set",
   sub:"shells on centres", deps:["read_xyz","read_ob"],
   out:"The molecule's shell list: centre, angular momentum, exponents, normalized coefficients; and the shell-to-function map",
   size:"N_shell; N functions",
   note:"Places each element's shells on every atom of that element and normalizes them."},
  {id:"abs", ph:'setup', mb:'Not budgeted. Fills n_aux, n_aux_shell and n_aux_prim: the records\u2019 and work lists\u2019 lengths, counted',   layer:2, x:9.8, kind:"setup", label:"create auxiliary basis set",
   sub:"shells on centres", deps:["read_xyz","read_ab"],
   out:"The fitting shell list and its shell-to-function map",
   size:"N_aux functions, typically 3 to 5 N",
   note:"Same construction as the orbital set, over the fitting shells."},

  // initial guess: superposition of atomic densities, read from a table
  {id:"guess", ph:"host", mb:"Device: n_ao² on gpu0 (D₀). Pinned scratch: its staging. Assembled on the host", layer:3, x:1.93, kind:"setup", label:"initial guess (SAD)",
   sub:"read D_atom, D₀ = ⊕ D_atom", deps:["obs"],
   out:"A starting density: each atom's block is its element's tabulated atomic density, and blocks between atoms are zero",
   size:"N × N, symmetric, block diagonal",
   note:"Reads one precomputed atomic density per distinct element, for this orbital basis, and places it on every atom of that element. No integral, S, H, X or electron count is needed: the atoms are neutral, and the first SCF diagonalization imposes the occupation."},

  // screening
  {id:"scr", ph:"step", mb:"Device: n_shell² bounds, and the kept-pair list at its bound", layer:3, x:7.4, kind:"int", label:"pair screening map",
   sub:"Q_μν = √(μν|μν)", deps:["obs"],
   out:"A bound for every orbital shell pair, and the list of pairs large enough to keep",
   size:"N_shell × N_shell bounds; N_pair kept",
   note:"The Schwarz bound: |(μν|P)| ≤ Q_μν √(P|P). It decides which shell pairs the three-centre integrals compute. Not in v0.0.4, which screens nothing."},

  // integrals: the one-electron matrices and the metric on the host
  {id:"S", ph:"host", mb:"Device: n_ao² on gpu0 (the upload). Pinned scratch: its staging. No library, no lock", layer:4, x:3.0, kind:"int", label:"overlap", sub:"S = (μ|ν)",
   deps:["obs"], out:"Overlap matrix", size:"N × N, symmetric",
   note:"One-electron, two-centre. Built on the host directly in the solid harmonics (s_overlap_host)."},
  {id:"T", ph:"host", mb:"Nothing: host scratch of the core-Hamiltonian step, O(n_ao²), outside the budget by policy", layer:4, x:4.0, kind:"int", label:"kinetic", sub:"T = (μ|−½∇²|ν)",
   deps:["obs"], out:"Kinetic energy matrix", size:"N × N, symmetric",
   note:"One-electron, two-centre, on the host (t_kinetic_host)."},
  {id:"V", ph:"host", mb:"Nothing: host scratch of the core-Hamiltonian step, O(n_ao²), outside the budget by policy", layer:4, x:5.0, kind:"int", label:"nuclear attraction",
   sub:"V = (μ|−Σ Z_A/r_A|ν)", deps:["obs","read_xyz"],
   out:"Nuclear attraction matrix", size:"N × N, symmetric",
   note:"The only one-electron integral that needs the nuclei themselves, not just the shell centres. On the host (v_potential_en_host)."},
  {id:"mnP", ph:"step", mb:"Part of eri: built a pair batch at a time in the ERI buffer's ring, on every GPU. Device: the ERI buffer, mem_per_gpu per GPU. Pinned: the ring's staging", layer:4, x:7.4, kind:"int", label:"three-centre integrals",
   sub:"(μν|P), a pair batch at a time", deps:["obs","abs","scr"],
   out:"Coulomb integrals between each orbital pair and each fitting function, one pair batch at a time",
   size:"a pair batch × N_aux, in the ring",
   note:"The most expensive node in the graph. Never resident whole: each GPU forms its own pair batches and fits them at once."},
  {id:"PQ", ph:"host", mb:"Device: n_aux² on every GPU (the upload). Pinned scratch: its staging. No library, no lock", layer:4, x:9.8, kind:"int", label:"fitting metric", sub:"J = (P|Q)",
   deps:["abs"], out:"Coulomb metric of the fitting basis",
   size:"N_aux × N_aux, symmetric positive definite",
   note:"Two-centre, two-electron, on the host (df_metric). Needs no orbital basis. An Output: the derivative steps read it too."},

  // linear algebra
  {id:"X", ph:"step", mb:"Device: n_ao² on gpu0. Scratch: the eigensolve’s work at n_ao. Holds gpu0’s lock", layer:5, x:3.55, kind:"la", label:"orthogonalizer", sub:"X: XᵀSX = 1",
   deps:["S"], out:"The transform to an orthonormal basis", size:"N × N (or N × N_kept)",
   note:"Symmetric S^(−1/2), or canonical with small eigenvalues of S dropped."},
  {id:"H", ph:"host", mb:"Device: n_ao² on gpu0 (the upload). Pinned scratch: its staging. No library, no lock", layer:5, x:4.6, kind:"la", label:"core Hamiltonian", sub:"H = T + V",
   deps:["T","V"], out:"The one-electron part of the Fock matrix",
   size:"N × N, symmetric", note:"A sum, on the host. The SCF never needs T and V apart, so they are the step's scratch and only H is uploaded."},
  {id:"L", ph:"step", mb:"Part of eri: device n_aux² on every GPU, in the EriManager. Holds every GPU’s lock", layer:5, x:9.8, kind:"la", label:"factor the metric", sub:"J = L Lᵀ",
   deps:["PQ"], out:"The Cholesky factor of the metric, on every GPU",
   size:"N_aux × N_aux",
   note:"The tree's own Cholesky recipe, on the GPU's stream before the first batch, overlapping that batch's kernels."},
  {id:"B", ph:"step", mb:"Part of eri: heap n_pair × n_aux at the unscreened bound, in the EriManager: the largest charge", layer:6, x:8.6, kind:"la", label:"fitting vectors",
   sub:"B = (μν|Q) L⁻ᵀ, on the host", deps:["mnP","L"],
   out:"B_μν^P, with (μν|λσ) ≈ Σ_P B_μν^P B_λσ^P", size:"N_pair × N_aux",
   note:"Each pair batch is fitted against L by the tree's trsm recipe on the GPU's stream, then downloaded into B's slab on the host heap. J/K passes contract it over aux batches, the cached ones from the GPUs' ERI buffers."},

  // boundary
  {id:"scf", ph:"step", mb:"The SCF step’s own: C, D, the orbital energies. Scratch: F, the DIIS ring, the eigensolve’s work at n_ao. Holds the EriManager’s lock and every GPU’s", layer:7, x:0, kind:"scf", wide:true, label:"SCF iterations",
   sub:"not executed: the graph ends here", deps:["nelec","enuc","S","X","H","B","guess"],
   out:"Nothing here. Each iteration would call the EriManager's build_jk with the density, add H, and diagonalize in the basis X gives.",
   size:"", note:"S is still needed inside: the convergence error FDS − SDF uses it."}
];

// What each node's mem_budget charges on gly10 in cc-pVDZ / cc-pVDZ-JKFIT, in bytes:
// d device (per GPU), p pinned, h host heap; parts for the tooltip. The ERI
// buffer is at an example mem_per_gpu of 2 GiB; its ring staging is illustrative.
const SQ = 4310048, AUX2 = 104025888;
const GLY = {
  guess: {d: SQ, p: SQ, parts: "D₀ on gpu0; its pinned staging, scratch"},
  scr:   {d: 1404936, parts: "342² bounds and the 58,653-pair list"},
  S:     {d: SQ, p: SQ, parts: "S on gpu0; its pinned staging, scratch"},
  mnP:   {d: 2147483648, p: 268435456,
          parts: "the ERI buffer on every GPU, mem_per_gpu = 2 GiB: the build’s ring of two pair batches with their records and work lists, then the fragments, the J/K batch buffer and the cache; pinned, the ring’s staging"},
  PQ:    {d: AUX2, p: AUX2, parts: "the metric on every GPU; its pinned staging, scratch"},
  X:     {d: SQ, parts: "X 4.3 MB; its eigensolve’s work is the scratch row"},
  H:     {d: SQ, p: SQ, parts: "H on gpu0; its pinned staging, scratch"},
  L:     {d: AUX2, parts: "the factor on every GPU, in the EriManager"},
  B:     {h: 7803297456, parts: "B’s slab on the host heap, 270,497 pair columns × 3606"},
};
const fmtB = b => {
  if (!b) return "0";
  const u = [["GB", 1e9], ["MB", 1e6], ["kB", 1e3]];
  for (const [n, v] of u) if (b >= v) return (b / v >= 100 ? (b / v).toFixed(0) : (b / v).toPrecision(3)) + "\u00a0" + n;
  return b + "\u00a0B";
};
const glyText = id => {
  const g = GLY[id];
  if (!g) return "";
  const kinds = [["device", g.d], ["pinned", g.p], ["heap", g.h]].filter(k => k[1] !== undefined)
    .map(([k, v]) => `${k} ${fmtB(v)}`).join(", ");
  return g.parts ? `${kinds} (${g.parts})` : kinds;
};
const logFrac = b => b <= 0 ? 0 : Math.max(0, Math.min(1, (Math.log10(b) - 2) / 8));

const U = 216, W = 200, HH = 48, LY = 104, PX = 18, PY = 16;
const XMAX = 9.8;
const TARGET_X = {};
const SIDE_EXIT = {"read_xyz>V": 3.2};
const PHASE = {config: "config", setup: "setup (not budgeted)",
               step: "a GPU step: budget mode, then execute mode",
               host: "a host step: built on rayon's threads, then uploaded"};
const byId = Object.fromEntries(NODES.map(n => [n.id, n]));
NODES.forEach(n => { n.deps = n.deps || []; n.kids = []; });
NODES.forEach(n => n.deps.forEach(d => byId[d].kids.push(n.id)));

const svgW = PX * 2 + W + XMAX * U, svgH = PY * 2 + 7 * LY + HH;
const NS = "http://www.w3.org/2000/svg";
const svg = document.getElementById("dag");
const el = (tag, attrs, parent) => {
  const e = document.createElementNS(NS, tag);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
};

const defs = el("defs", {}, svg);
for (const id of ["mk", "mkon"]) {
  const m = el("marker", {id, viewBox: "0 0 10 10", refX: 9, refY: 5,
    markerWidth: 7, markerHeight: 7, orient: "auto-start-reverse"}, defs);
  el("path", {d: "M0,1 L10,5 L0,9 z"}, m);
}

const left = n => PX + n.x * U;
const width = n => n.wide ? W + XMAX * U : W;
const cx = n => left(n) + width(n) / 2;
const top = n => PY + n.layer * LY;

const gEdges = el("g", {}, svg), gNodes = el("g", {}, svg);
const edgeEls = [];
NODES.forEach(t => t.deps.forEach(sid => {
  const s = byId[sid];
  const key = sid + ">" + t.id;
  const sx = cx(s), sy = top(s) + HH;
  let tx = t.wide ? sx : cx(t);
  if (TARGET_X[key] !== undefined) tx = PX + TARGET_X[key] * U;
  const ty = top(t) - 2;
  const k = (ty - sy) * 0.5;
  let d = `M${sx},${sy} C${sx},${sy + k} ${tx},${ty - k} ${tx},${ty}`;
  if (SIDE_EXIT[key] !== undefined) {
    const x0 = left(s) + width(s), y0 = top(s) + HH / 2;
    d = `M${x0},${y0} C${PX + SIDE_EXIT[key] * U},${y0} ` +
        `${tx},${y0 + (ty - y0) * 0.45} ${tx},${ty}`;
  }
  const p = el("path", {class: "edge", "marker-end": "url(#mk)", d}, gEdges);
  edgeEls.push({s: sid, t: t.id, p});
}));

const nodeEls = {};
NODES.forEach(n => {
  const g = el("g", {class: `node k-${n.kind}`, tabindex: 0}, gNodes);
  el("rect", {x: left(n), y: top(n), width: width(n), height: HH}, g);
  const t = el("text", {class: "t", x: cx(n), y: top(n) + 20, "text-anchor": "middle"}, g);
  t.textContent = n.label;
  const s = el("text", {class: "s", x: cx(n), y: top(n) + 37, "text-anchor": "middle"}, g);
  s.textContent = n.sub;
  if (GLY[n.id]) {
    const g0 = GLY[n.id], tot = (g0.d || 0) + (g0.p || 0) + (g0.h || 0);
    const r = el("rect", {class: "mb", x: left(n) + 8, y: top(n) + HH - 6,
      width: Math.max(2, (width(n) - 16) * logFrac(tot)), height: 3, rx: 1.5}, g);
    const tt = el("title", {}, r); tt.textContent = "gly10: " + glyText(n.id);
  }
  for (const [node, px] of [[t, 13.5], [s, 12]]) {
    const room = width(n) - 16, len = node.getComputedTextLength();
    if (len > room) node.style.fontSize = (px * room / len).toFixed(2) + "px";
  }
  nodeEls[n.id] = g;
  g.addEventListener("mouseenter", () => { if (!pinned) show(n.id); });
  g.addEventListener("mouseleave", () => { if (!pinned) show(null); });
  g.addEventListener("click", e => {
    e.stopPropagation();
    if (moved) return;
    pinned = pinned === n.id ? null : n.id;
    show(pinned || n.id);
  });
  g.addEventListener("keydown", e => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); g.dispatchEvent(new Event("click")); }
  });
});
svg.addEventListener("click", () => { if (moved) return; pinned = null; show(null); });

let pinned = null;

// Pan and zoom: the view is a window (x, y, scale k) onto the graph.
const frame = document.getElementById("frame");
const view = {x: 0, y: 0, k: 1};
let moved = false;
const size = () => frame.getBoundingClientRect();
function apply() {
  const r = size();
  svg.setAttribute("viewBox", `${view.x} ${view.y} ${r.width / view.k} ${r.height / view.k}`);
}
function fit() {
  const r = size();
  view.k = Math.min(r.width / svgW, r.height / svgH);
  view.x = -(r.width / view.k - svgW) / 2;
  view.y = -(r.height / view.k - svgH) / 2;
  apply();
}
function readable() {
  const r = size();
  view.k = Math.min(1, r.height / svgH);
  view.x = Math.min(0, -(r.width / view.k - svgW) / 2);
  view.y = -(r.height / view.k - svgH) / 2;
  apply();
}
function zoomAt(px, py, f) {
  const k = Math.min(3, Math.max(0.15, view.k * f));
  view.x += px / view.k - px / k;
  view.y += py / view.k - py / k;
  view.k = k;
  apply();
}
const centre = f => { const r = size(); zoomAt(r.width / 2, r.height / 2, f); };
document.getElementById("zin").onclick = () => centre(1.25);
document.getElementById("zout").onclick = () => centre(0.8);
document.getElementById("zfit").onclick = fit;
document.getElementById("zone").onclick = readable;
frame.addEventListener("wheel", e => {
  if (!e.ctrlKey && !e.metaKey) return;
  e.preventDefault();
  const r = size();
  zoomAt(e.clientX - r.left, e.clientY - r.top, Math.exp(-e.deltaY * 0.01));
}, {passive: false});
let grab = null;
frame.addEventListener("pointerdown", e => {
  if (e.button !== 0) return;
  moved = false;
  grab = {px: e.clientX, py: e.clientY, x: view.x, y: view.y};
});
window.addEventListener("pointermove", e => {
  if (!grab) return;
  const dx = e.clientX - grab.px, dy = e.clientY - grab.py;
  if (!moved && Math.hypot(dx, dy) < 4) return;
  moved = true;
  frame.classList.add("drag");
  view.x = grab.x - dx / view.k;
  view.y = grab.y - dy / view.k;
  apply();
});
window.addEventListener("pointerup", () => { grab = null; frame.classList.remove("drag"); });
window.addEventListener("resize", apply);
readable();
const reach = (id, key) => {
  const seen = new Set(), stack = [id];
  while (stack.length) for (const m of byId[stack.pop()][key])
    if (!seen.has(m)) { seen.add(m); stack.push(m); }
  return seen;
};
const names = ids => ids.length ? ids.map(i => byId[i].label).join(", ") : "nothing";

const detail = document.getElementById("detail");
function show(id) {
  const up = id ? reach(id, "deps") : null, down = id ? reach(id, "kids") : null;
  for (const n of NODES) {
    const g = nodeEls[n.id];
    g.classList.toggle("dim", !!id && n.id !== id && !up.has(n.id) && !down.has(n.id));
    g.classList.toggle("sel", n.id === id);
  }
  for (const e of edgeEls) {
    const on = !!id && ((e.t === id || up.has(e.t)) && up.has(e.s) ||
                        (e.s === id || down.has(e.s)) && down.has(e.t));
    e.p.classList.toggle("on", on);
    e.p.classList.toggle("dim", !!id && !on);
    e.p.setAttribute("marker-end", on ? "url(#mkon)" : "url(#mk)");
  }
  detail.textContent = "";
  if (!id) {
    const p = document.createElement("p");
    p.style.color = "var(--muted)"; p.style.margin = "0";
    p.textContent = "Select a node to see what it produces, how big that is, and what it depends on.";
    detail.appendChild(p);
    return;
  }
  const n = byId[id];
  const h = document.createElement("h3");
  h.textContent = n.label;
  const dl = document.createElement("dl");
  const rows = [["Produces", n.out], ["Size", n.size], ["Needs", names(n.deps)],
                ["Needed by", names(n.kids)], ["Phase", PHASE[n.ph]],
                ["mem_budget", n.mb], ["On gly10", glyText(n.id)], ["Note", n.note]];
  for (const [k, v] of rows) {
    if (!v) continue;
    const dt = document.createElement("dt"), dd = document.createElement("dd");
    dt.textContent = k; dd.textContent = v; dl.append(dt, dd);
  }
  detail.append(h, dl);
}
show(null);

const tbody = document.querySelector("#tbl tbody");
for (const n of NODES) {
  if (n.kind === "input" || n.kind === "scf") continue;
  const tr = document.createElement("tr");
  for (const v of [n.label, n.out, n.size, names(n.deps), n.ph, n.mb, glyText(n.id)]) {
    const td = document.createElement("td"); td.textContent = v; tr.appendChild(td);
  }
  tbody.appendChild(tr);
}

// The per-node budget chart: one row per step node and the scratch, log scale.
{
  const bsvg = document.getElementById("budgetbars");
  const rows = NODES.filter(n => GLY[n.id]).map(n => ({label: n.label, id: n.id, ...GLY[n.id]}));
  rows.push({label: "scratch (final node, packed)", d: 8655336,
             parts: "the eigensolve at n_ao, by the LAPACK formula; X and the SCF share it"});
  const LX = 236, X0 = 250, X1 = 790, TOP = 22, BH = 7, GAP = 2;
  const kindsOf = r => [["d", "var(--c1)", "device"], ["p", "var(--c2)", "pinned"],
                        ["h", "var(--c3)", "heap"]].filter(k => r[k[0]] !== undefined);
  let y = TOP;
  const placed = rows.map(r => {
    const ks = kindsOf(r), h = Math.max(1, ks.length) * (BH + GAP) - GAP;
    const row = {r, ks, y, h: Math.max(h, 14)};
    y += row.h + 10;
    return row;
  });
  const H = y + 4, Wd = 900;
  bsvg.setAttribute("viewBox", `0 0 ${Wd} ${H}`);
  const xOf = b => X0 + (X1 - X0) * logFrac(b);
  const ticks = ["100 B", "1 kB", "10 kB", "100 kB", "1 MB", "10 MB", "100 MB", "1 GB", "10 GB"];
  ticks.forEach((t, i) => {
    const x = X0 + (X1 - X0) * i / 8;
    el("line", {class: "grid", x1: x, y1: TOP - 6, x2: x, y2: H - 4}, bsvg);
    const tx = el("text", {x, y: 12, "text-anchor": "middle", class: "m s"}, bsvg);
    tx.textContent = t;
  });
  for (const {r, ks, y: ry, h} of placed) {
    const g = el("g", {class: "brow"}, bsvg);
    const tl = el("title", {}, g);
    tl.textContent = r.label + ": " + glyText(r.id) + (r.id ? "" : `device ${fmtB(r.d)} (${r.parts})`);
    el("rect", {x: 0, y: ry - 4, width: Wd, height: h + 8, fill: "transparent"}, g);
    const lt = el("text", {x: LX, y: ry + h / 2 + 4, "text-anchor": "end"}, g);
    lt.textContent = r.label;
    if (!ks.length || ks.every(k => !r[k[0]])) {
      const z = el("text", {x: X0 + 4, y: ry + h / 2 + 4, class: "m s"}, g);
      z.textContent = "nothing";
      continue;
    }
    ks.forEach(([k, col], i) => {
      const by = ry + i * (BH + GAP) + (h - (ks.length * (BH + GAP) - GAP)) / 2;
      const xe = Math.max(X0 + 2, xOf(r[k]));
      el("rect", {class: "bar", x: X0, y: by, width: xe - X0, height: BH, rx: 2,
                  style: `fill:${col}`}, g);
      const v = el("text", {x: xe + 5, y: by + BH - 0.5, class: "m s"}, g);
      v.textContent = fmtB(r[k]);
    });
  }
}
})();
</script>
@@ replace-pre GPU's stream:  eri [
<figure><div class="scroll">
<svg viewBox="0 0 800 244" role="img" aria-label="Streams on gpu0 over time. eri holds gpu0's lock: on the GPU's stream it factors the metric, then fits batches 0, 1 and 2 one after another. On eri's own two ring streams, drawn above and below it, each batch's kernels run before its fit and its copy after it, joined to the GPU's stream by events, so batch 1's kernels overlap batch 0's fit. After the wrapper's sync eri releases the lock and the orthogonalizer takes it, putting its eigensolve and gemms on the GPU's stream. The host steps' uploads (S, H, the guess) call no library, run on their own streams and hold no lock.">
<defs>
<marker id="v4e" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="at" d="M0,0L10,5L0,10z"/></marker>
</defs>
<text class="sm mt" x="20" y="42">gpu0's lock</text>
<rect class="ab" x="180" y="30" width="425" height="16"/>
<text class="sm" x="392" y="42" text-anchor="middle">eri holds it for its whole run</text>
<rect class="ab" x="625" y="30" width="145" height="16"/>
<text class="sm" x="697" y="42" text-anchor="middle">orthogonalizer</text>
<text class="sm" x="20" y="79">eri's ring stream 1</text>
<rect class="row" x="276" y="64" width="80" height="22"/>
<text class="sm" x="316" y="79" text-anchor="middle">kernels 1</text>
<rect class="row" x="436" y="64" width="46" height="22"/>
<text class="sm" x="459" y="79" text-anchor="middle">copy 1</text>
<text class="sm" x="20" y="119">gpu0's stream</text>
<rect class="row" x="180" y="104" width="70" height="22"/>
<text class="sm" x="215" y="119" text-anchor="middle">factor L</text>
<rect class="row" x="284" y="104" width="62" height="22"/>
<text class="sm" x="315" y="119" text-anchor="middle">fit 0</text>
<rect class="row" x="366" y="104" width="62" height="22"/>
<text class="sm" x="397" y="119" text-anchor="middle">fit 1</text>
<rect class="row" x="480" y="104" width="62" height="22"/>
<text class="sm" x="511" y="119" text-anchor="middle">fit 2</text>
<rect class="row" x="630" y="104" width="135" height="22"/>
<text class="sm" x="697" y="119" text-anchor="middle">syevd, gemms</text>
<text class="sm" x="20" y="159">eri's ring stream 0</text>
<rect class="row" x="190" y="144" width="84" height="22"/>
<text class="sm" x="232" y="159" text-anchor="middle">kernels 0</text>
<rect class="row" x="354" y="144" width="46" height="22"/>
<text class="sm" x="377" y="159" text-anchor="middle">copy 0</text>
<rect class="row" x="408" y="144" width="64" height="22"/>
<text class="sm" x="440" y="159" text-anchor="middle">kernels 2</text>
<rect class="row" x="550" y="144" width="46" height="22"/>
<text class="sm" x="573" y="159" text-anchor="middle">copy 2</text>
<text class="sm" x="20" y="205">host steps' streams</text>
<rect class="box" x="230" y="190" width="170" height="22"/>
<text class="sm" x="315" y="205" text-anchor="middle">uploads: no library, no lock</text>
<path class="al" d="M274,144L286,128" marker-end="url(#v4e)"/>
<path class="al" d="M346,126L356,143" marker-end="url(#v4e)"/>
<path class="al" d="M356,86L368,102" marker-end="url(#v4e)"/>
<path class="al" d="M428,104L438,88" marker-end="url(#v4e)"/>
<path class="al" d="M472,144L482,128" marker-end="url(#v4e)"/>
<path class="al" d="M542,126L552,143" marker-end="url(#v4e)"/>
<path class="ln dash" d="M614,24V218"/>
<text class="sm mt" x="614" y="236" text-anchor="middle">the wrapper syncs every stream, then releases</text>
<text class="sm at" x="180" y="236">arrows: events inside eri</text>
</svg></div>
<figcaption>Streams on gpu0. <code>eri</code> holds the lock, so the GPU's stream is its own for the run: the factor, then each pair batch's fit. Its two ring streams carry the kernels and the copies, joined to the GPU's stream by events, so a batch's kernels overlap the batch before's fit and two fits never overlap. The orthogonalizer waits for the lock. The host steps' uploads call no library and overlap all of it. Every other GPU runs the same for <code>eri</code>'s share. Not to scale.</figcaption>
</figure>
@@ replace-pre overlap ──&gt; orthogonalizer
<figure><div class="scroll">
<svg viewBox="0 0 800 262" role="img" aria-label="The step graph of DF-RHF. overlap, core_hamiltonian, metric and guess are host steps that upload and take no lock. overlap is read by orthogonalizer, metric by eri. orthogonalizer, core_hamiltonian, eri and guess are read by scf. orthogonalizer holds gpu0's lock, eri every GPU's, and scf the EriManager's and every GPU's.">
<defs>
<marker id="v4a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path class="fh" d="M0,0L10,5L0,10z"/></marker>
</defs>
<rect class="box" x="20" y="20" width="170" height="44" rx="4"/>
<text class="t" x="105" y="38" text-anchor="middle">overlap</text>
<text class="sm mt" x="105" y="54" text-anchor="middle">host, then gpu0</text>
<rect class="box" x="20" y="80" width="170" height="44" rx="4"/>
<text class="t" x="105" y="98" text-anchor="middle">core_hamiltonian</text>
<text class="sm mt" x="105" y="114" text-anchor="middle">host, then gpu0</text>
<rect class="box" x="20" y="140" width="170" height="44" rx="4"/>
<text class="t" x="105" y="158" text-anchor="middle">metric</text>
<text class="sm mt" x="105" y="174" text-anchor="middle">host, then every GPU</text>
<rect class="box" x="20" y="200" width="170" height="44" rx="4"/>
<text class="t" x="105" y="218" text-anchor="middle">guess</text>
<text class="sm mt" x="105" y="234" text-anchor="middle">host, then gpu0</text>
<rect class="ab" x="260" y="20" width="180" height="44" rx="4"/>
<text class="t" x="350" y="38" text-anchor="middle">orthogonalizer</text>
<text class="sm mt" x="350" y="54" text-anchor="middle">gpu0, holds its lock</text>
<rect class="ab" x="260" y="140" width="180" height="44" rx="4"/>
<text class="t" x="350" y="158" text-anchor="middle">eri</text>
<text class="sm mt" x="350" y="174" text-anchor="middle">every GPU, each lock</text>
<rect class="ab" x="560" y="110" width="200" height="44" rx="4"/>
<text class="t" x="660" y="128" text-anchor="middle">scf</text>
<text class="sm mt" x="660" y="144" text-anchor="middle">EriManager, every GPU</text>
<path class="ln" d="M190,42H258" marker-end="url(#v4a)"/>
<path class="ln" d="M190,162H258" marker-end="url(#v4a)"/>
<path class="ln" d="M440,42C500,42 500,118 558,118" marker-end="url(#v4a)"/>
<path class="ln" d="M190,102C380,102 470,127 558,127" marker-end="url(#v4a)"/>
<path class="ln" d="M440,162C500,162 500,137 558,137" marker-end="url(#v4a)"/>
<path class="ln" d="M190,222C400,222 480,147 558,147" marker-end="url(#v4a)"/>
</svg></div>
<figcaption>The step DAG. The four host steps build on rayon's threads and upload; an upload calls no library, so they take no lock and overlap the GPU work. The three outlined steps call the library: the orthogonalizer and <code>eri</code> are unordered and take gpu0's lock one after the other, and <code>scf</code> takes the <code>EriManager</code>'s lock and then every GPU's, in rank order. The SCF's loop is inside its node. Budget mode adds one final node after all seven.</figcaption>
</figure>
