    <rect x="216" y="12" width="20" height="22" style="fill:var(--c2)"><title>The metric and its factor: 0.21 GB</title></rect>
    <rect x="238" y="12" width="13" height="22" style="fill:var(--c3)"><title>The handle workspace: 0.13 GB (128 MiB)</title></rect>
    <rect x="253" y="12" width="4" height="22" style="fill:var(--c4)"><title>Everything else: S, H, X, D₀, the screening map and the eigensolve's scratch, 0.027 GB</title></rect>
  </g>
  <text x="265" y="28" class="s">gpu0: 2.52 GB, device</text>
  <g>
    <rect x="10" y="62" width="742" height="22" style="fill:var(--c1)"><title>B's slab on the host heap: 7.80 GB</title></rect>
    <rect x="754" y="62" width="37" height="22" style="fill:var(--c2)"><title>Pinned: the ERI ring's staging and the host steps' staging: 0.39 GB</title></rect>
  </g>
