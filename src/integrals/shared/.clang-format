# eval_boys.h here is generated by FelizJueves (tools/emit_one_electron_kernels.py
# and tools/emit_coulomb_kernels.py) and committed as emitted: reformatting it
# would turn every regeneration into a whole-file diff. DisableFormat makes
# `clang-format --dry-run -Werror` (the commit hook and CI) accept it as is.
DisableFormat: true
SortIncludes: Never
