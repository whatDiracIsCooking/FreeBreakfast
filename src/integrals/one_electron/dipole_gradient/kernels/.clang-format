# The kernels here are generated by FelizJueves
# (tools/emit/dipole_gradient_kernels.py) and committed as emitted:
# reformatting them would turn every regeneration into a whole-file diff.
# DisableFormat makes `clang-format --dry-run -Werror` (the commit hook and CI)
# accept them as is.
DisableFormat: true
SortIncludes: Never
