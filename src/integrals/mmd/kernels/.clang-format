# The kernels here are generated by FelizJueves
# (tools/emit/one_electron_kernels.py: pair_bound/;
# tools/emit/exchange_kernels.py: record_bound/) and committed as emitted: reformatting
# them would turn every regeneration into a whole-file diff. DisableFormat makes
# `clang-format --dry-run -Werror` (the commit hook and CI) accept them as is.
DisableFormat: true
SortIncludes: Never
