# The kernels here are generated by FelizJueves
# (tools/emit/one_electron_kernels.py --out-root: pair_bound/;
# tools/emit/exchange_kernels.py --out-root: record_bound/) and committed as
# emitted, byte for byte the units under src/integrals/mmd/kernels/:
# reformatting them would turn every regeneration into a whole-file diff.
# DisableFormat makes `clang-format --dry-run -Werror` (the commit hook and
# CI) accept them as is.
DisableFormat: true
SortIncludes: Never
