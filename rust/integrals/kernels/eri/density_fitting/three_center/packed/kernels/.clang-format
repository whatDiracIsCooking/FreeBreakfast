# The kernels here are generated by FelizJueves
# (tools/emit/packed_three_center_kernels.py) and committed as emitted,
# rust/'s own with no C++ twin: reformatting them would turn every
# regeneration into a whole-file diff. DisableFormat makes
# `clang-format --dry-run -Werror` (the commit hook and CI) accept them as is.
DisableFormat: true
SortIncludes: Never
