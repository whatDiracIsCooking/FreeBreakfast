# eval_boys.h and the eval_boys_{M}.h it includes are generated by FelizJueves
# (tools/emit/one_electron_kernels.py --out-root) and committed as emitted,
# byte for byte those under src/integrals/shared/: reformatting them would
# turn every regeneration into a whole-file diff. DisableFormat makes
# `clang-format --dry-run -Werror` (the commit hook and CI) accept them as is.
DisableFormat: true
SortIncludes: Never
