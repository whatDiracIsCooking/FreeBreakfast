# The nightly (docs/testing.md "The nightly"): devtools/test.py nightly,
# inside this checkout's combined devcontainer, from the HOST's systemd user
# manager. A template: the instance is the primary checkout's path, escaped,
# so nothing here names a machine or a user.
#
# The path is %f, never %I: %I unescapes the instance but drops the leading
# "/" that `systemd-escape --path` strips, so bash resolved the relative path
# against $HOME and the first unattended night exited 127 (#985).
#
#   systemctl --user link "$PWD/devtools/systemd/free-breakfast-nightly@.service"
#   systemctl --user link "$PWD/devtools/systemd/free-breakfast-nightly@.timer"
#   systemctl --user enable --now \
#     "free-breakfast-nightly@$(systemd-escape --path "$PWD").timer"
#
# docs/testing.md has the rest: linger, a first run by hand, the journal.

[Unit]
Description=free-breakfast nightly: test.py nightly in %f
Documentation=file://%f/docs/testing.md

[Service]
Type=oneshot
# A login shell, for the PATH that finds npx (devcontainer.sh's CLI) and the
# docker group of a login. devcontainer.sh's `shell` refuses, naming `up`,
# when the container is not running: a stopped container fails the night
# loudly rather than being rebuilt unattended. The combined variant, because
# the nightly's cross-backend check needs hipconfig as well as nvcc.
# `$$` is a literal `$` to systemd.
Environment=FREE_BREAKFAST_ROOT=%f
ExecStart=/bin/bash -lc 'exec "$${FREE_BREAKFAST_ROOT}/devtools/devcontainer.sh" --combined shell -c "$${FREE_BREAKFAST_ROOT}/devtools/test.py nightly"'
# A backstop only: the GPU batches have their own watchdog, and a run that
# waits on a held card waits with no timeout of its own.
TimeoutStartSec=16h
