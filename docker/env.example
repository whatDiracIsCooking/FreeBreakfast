# Copy to docker/.env and adjust. Every variable below is optional except
# HOST_UID / HOST_GID, which compose.yaml requires so container-written files
# are owned by you rather than root.
#
#   cp docker/env.example docker/.env
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> docker/.env
#
# docker/.env is gitignored; this example file is committed.

# --- Required ---------------------------------------------------------------
HOST_UID=1000
HOST_GID=1000

# --- Image ------------------------------------------------------------------
# Tag built by (note: the Dockerfile is at the REPO ROOT, not in this dir --
# it is shared with .devcontainer/ so the two cannot drift):
#   DOCKER_BUILDKIT=1 docker build -t free-breakfast:latest .
FREE_BREAKFAST_IMAGE=free-breakfast:latest

# --- Compiler cache ---------------------------------------------------------
# Host directory holding the sccache store, bind-mounted to /sccache in every
# service. Defaults to this checkout's own .sccache (relative to docker/), which
# IS the shared one when you run from the main checkout.
#
# From a worktree, point it at main's store to share hits with every other
# checkout -- every compose service mounts the tree at /workspace, so the cache
# keys match whichever worktree you ran from. (The devcontainer cannot do this:
# it mounts each worktree at its own host path. See its containerEnv comment.)
# The directory must already exist; docker creates a missing bind source as root.
#FREE_BREAKFAST_SCCACHE_HOST_DIR=/abs/path/to/<root>/main/.sccache

# --- Build ------------------------------------------------------------------
# CMake preset name. See CMakePresets.json for the full list.
BUILD_PRESET=default

# The build directory each compose service configures into. Compose and the
# devcontainer CANNOT share one: the devcontainer mounts the workspace at its
# host path while compose mounts it at /workspace, and a CMake cache records
# absolute source and binary directories -- so a tree configured by one front
# end is rejected by the other. Each service defaults to its own
# build-compose*/ for exactly that reason; override only if you know why.
#BUILD_DIR=build-compose
# Set any of these to 1 to change build behaviour.
#CLEAN=1          # remove compiled objects first
#RECONFIGURE=1    # wipe the CMake cache and reconfigure
#REBUILD=1        # both of the above
#BUILD_ONLY=1     # skip configure, just compile

# --- Test -------------------------------------------------------------------
#TEST_FILTER=Constants.*   # value for --gtest_filter
#PYTEST_ARGS=-k smoke      # extra pytest arguments
#SKIP_GTEST=1
#SKIP_PYTEST=1
#TIMEOUT_MULTIPLIER=1
# Which GPU to expose; passed through from your shell if unset.
#CUDA_VISIBLE_DEVICES=0

# --- Sanitizers -------------------------------------------------------------
# memcheck | racecheck | initcheck | synccheck
#COMPUTE_SANITIZER_TOOL=memcheck
